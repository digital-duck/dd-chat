# Copy to `.env` (git-ignored) in the folder where you start dd-chat, or to ~/.dd-chat/.env, and fill in the keys you use.
# Precedence: (1) a key typed on the Settings page  >  (2) environment variables  >  (3) this .env file (defaults only).
# An empty value counts as not set. The `anthropic` (Claude CLI) and `ollama` providers need no key.

ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
